# Database (Neon Postgres)
# Pooled connection string, used by the app
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct connection string, for running schema migrations with psql
DATABASE_URL_UNPOOLED=

# Server
SERVER_PORT=8000

# Client
CLIENT_ORIGIN=http://localhost
CLIENT_PORT=5173

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=feeder-backend
MQTT_USER=
MQTT_PASS=

# JWT (at least 32 characters)
JWT_SECRET=
